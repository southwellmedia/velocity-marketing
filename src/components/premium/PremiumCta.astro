---
/**
 * Closing call to action for /premium, on the site's orange CTA band.
 */
import { checkoutUrl, price } from '@/data/premium';
---

<section class="v-cta">
  <div class="v-cta-grid" aria-hidden="true"></div>
  <div class="v-cta-grain" aria-hidden="true"></div>
  <svg class="v-cta-mark" viewBox="0 0 90 101" fill="currentColor" aria-hidden="true">
    <path d="M35.1288 23.8398L45.1667 49.4151L56.2482 23.8398H87.1082C86.5647 23.3764 85.9776 22.9637 85.3616 22.5944L48.6165 0.704798C46.377 -0.0699896 43.4273 -0.439281 41.2675 0.842377L3.36286 23.3692C3.13819 23.5067 2.92801 23.666 2.72508 23.8326H35.1288V23.8398Z"></path>
    <path d="M0.144951 28.8578C0.079723 29.2851 0.0434853 29.7123 0.0434853 30.1323L0 72.036C0 76.1778 1.95684 78.3936 5.26172 80.3631L39.4919 100.703L0.144951 28.8578Z"></path>
    <path d="M89.9203 28.7058L50.0588 101L86.6661 79.1539C88.7027 77.9374 90 75.0265 90 72.6442L89.9783 29.6037C89.9783 29.2923 89.9493 28.9954 89.913 28.6985L89.9203 28.7058Z"></path>
  </svg>
  <div class="relative container flex flex-col items-start gap-8">
    <p class="text-xs font-semibold tracking-widest uppercase">
      {price} once · Every current and future template
    </p>
    <h2 class="v-display v-giant v-cta-title">Your next site is already built.</h2>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <a
        class="inline-flex h-16 items-center rounded-[10px] bg-[var(--gray-950)] px-7 text-lg font-semibold text-white no-underline hover:bg-[var(--gray-900)]"
        href={checkoutUrl}
      >
        Get lifetime access
      </a>
      <span class="text-sm font-medium">Requires a free GitHub account.</span>
    </div>
  </div>
</section>
