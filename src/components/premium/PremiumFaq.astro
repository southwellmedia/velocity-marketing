---
/**
 * Buying questions, as native disclosure widgets (no JavaScript).
 */
const faqs = [
  {
    q: 'Can I use the templates for client work?',
    a: 'Yes. The license covers unlimited sites, including sites you build and sell to clients.',
  },
  {
    q: 'How do I get the code?',
    a: 'After checkout, Polar invites your GitHub account to the private templates repository. You need a free GitHub account.',
  },
  {
    q: 'Are the demo photos included?',
    a: 'No. Demo photos are not included, so swap in your own before you launch.',
  },
  {
    q: 'Do future templates cost extra?',
    a: 'No. Planned templates are included in lifetime access when they ship.',
  },
  {
    q: 'Can I get a refund?',
    a: 'All sales are final, because you get the full source on purchase. Open every demo before you buy.',
  },
];
---

<section class="v-section">
  <div class="container grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-12">
    <div class="flex flex-col gap-4">
      <p class="v-eyebrow">Questions</p>
      <h2 class="v-display v-h3 text-[clamp(2rem,1.5rem+2vw,3.25rem)]!">Before you buy.</h2>
    </div>
    <div class="border-border border-b">
      {faqs.map((faq, index) => (
        <details class="v-faq" open={index === 0}>
          <summary>
            {faq.q}
            <span class="v-faq-icon" aria-hidden="true" />
          </summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
