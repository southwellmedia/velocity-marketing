---
/**
 * Patterns that ship inside the templates, each drawn as a small sketch in
 * grays with the template it comes from.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

const patterns = [
  {
    title: 'Booking forms',
    body: 'Reason, provider and date in one short form on the home page.',
    source: 'From Medical Practice',
    sketch: 'booking',
  },
  {
    title: 'Search and filters',
    body: 'Buy, rent and sell tabs with location, type and bedroom filters.',
    source: 'From Real Estate',
    sketch: 'search',
  },
  {
    title: 'Product spotlights',
    body: 'A feature card that sells one product from the hero, with wishlist and bag in the header.',
    source: 'From E-commerce Store',
    sketch: 'spotlight',
  },
  {
    title: 'Listings and detail pages',
    body: 'Listing grids that lead to full detail pages, saved homes and tour booking.',
    source: 'From Real Estate',
    sketch: 'listings',
  },
  {
    title: 'English and Spanish',
    body: 'Both languages ship, with translated URLs and a switch in the header.',
    source: 'In every template',
    sketch: 'i18n',
  },
  {
    title: 'Light and dark',
    body: 'Both themes, with the toggle in the header wired up.',
    source: 'In every template',
    sketch: 'themes',
  },
] as const;
---

<section id="patterns" class="v-section">
  <div class="container flex flex-col gap-12 lg:gap-14">
    <div class="flex max-w-[42rem] flex-col gap-4">
      <p class="v-eyebrow">Premium patterns</p>
      <h2 class="v-display v-h2">The hard parts, already built.</h2>
      <p class="v-lead">
        Every template ships patterns you would otherwise build from scratch. Lift them into your
        own pages; they use the same Velocity components and tokens.
      </p>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {patterns.map((pattern) => (
        <li class="v-surface flex flex-col overflow-hidden">
          <div class="v-pattern-art" aria-hidden="true">
            {pattern.sketch === 'booking' && (
              <div class="flex w-full flex-col gap-2.5">
                <span class="text-foreground text-[0.8125rem] font-semibold">Book a visit</span>
                <span class="v-pattern-field" />
                <span class="flex gap-2">
                  <span class="v-pattern-field flex-1" />
                  <span class="v-pattern-field flex-1" />
                </span>
                <span class="bg-foreground h-8 rounded-full opacity-90" />
              </div>
            )}
            {pattern.sketch === 'search' && (
              <div class="flex w-full flex-col gap-2.5">
                <span class="flex gap-1.5 text-xs font-semibold">
                  <span class="bg-foreground text-background rounded-full px-3 py-1.5">Buy</span>
                  <span class="text-foreground-muted px-3 py-1.5">Rent</span>
                  <span class="text-foreground-muted px-3 py-1.5">Sell</span>
                </span>
                <span class="v-pattern-field" />
                <span class="flex gap-2">
                  <span class="v-pattern-field flex-1" />
                  <span class="v-pattern-field flex-1" />
                  <span class="bg-foreground h-9 w-20 rounded-lg opacity-90" />
                </span>
              </div>
            )}
            {pattern.sketch === 'spotlight' && (
              <div class="bg-foreground text-background mt-auto flex w-full items-center gap-3 rounded-[10px] p-3">
                <span class="bg-foreground-muted size-12 shrink-0 rounded-md" />
                <span class="flex flex-1 flex-col gap-1.5">
                  <span class="text-[0.6875rem] font-bold tracking-widest">SPOTLIGHT</span>
                  <span class="bg-foreground-subtle h-1.5 w-3/4 rounded-full" />
                  <span class="bg-foreground-subtle h-1.5 w-1/3 rounded-full" />
                </span>
                <span class="bg-background size-8 shrink-0 rounded-full" />
              </div>
            )}
            {pattern.sketch === 'listings' && (
              <div class="grid h-full w-full grid-cols-2 gap-2.5">
                {[0, 1].map((n) => (
                  <span class="border-border-strong flex flex-col justify-end gap-1.5 rounded-lg border p-2.5">
                    <span
                      class:list={[
                        'bg-foreground-secondary h-2 rounded-full',
                        n ? 'w-1/2' : 'w-3/5',
                      ]}
                    />
                    <span
                      class:list={['bg-border-strong h-1.5 rounded-full', n ? 'w-2/3' : 'w-4/5']}
                    />
                  </span>
                ))}
              </div>
            )}
            {pattern.sketch === 'i18n' && (
              <div class="flex w-full flex-wrap items-center justify-center gap-3 font-mono text-[0.8125rem]">
                <span class="border-foreground-secondary text-foreground rounded-lg border px-3 py-2">
                  /rentals
                </span>
                <Icon name="arrow-right" size="sm" class="text-foreground-subtle" />
                <span class="border-border-strong text-foreground-muted rounded-lg border px-3 py-2">
                  /es/alquileres
                </span>
              </div>
            )}
            {pattern.sketch === 'themes' && (
              <div class="-m-6 flex h-[calc(100%+3rem)] w-[calc(100%+3rem)]">
                <span class="flex flex-1 flex-col justify-center gap-2 bg-[var(--gray-50)] p-6">
                  <span class="h-2.5 w-[70%] rounded-full bg-[var(--gray-900)]" />
                  <span class="h-1.5 w-[90%] rounded-full bg-[var(--gray-300)]" />
                  <span class="h-1.5 w-[60%] rounded-full bg-[var(--gray-300)]" />
                </span>
                <span class="flex flex-1 flex-col justify-center gap-2 bg-[var(--gray-900)] p-6">
                  <span class="h-2.5 w-[70%] rounded-full bg-[var(--gray-50)]" />
                  <span class="h-1.5 w-[90%] rounded-full bg-[var(--gray-700)]" />
                  <span class="h-1.5 w-[60%] rounded-full bg-[var(--gray-700)]" />
                </span>
              </div>
            )}
          </div>
          <div class="flex flex-1 flex-col gap-1.5 p-5 pb-6 sm:px-6">
            <h3 class="v-display text-xl">{pattern.title}</h3>
            <p class="text-foreground-muted text-sm leading-relaxed">{pattern.body}</p>
            <span class="text-foreground-subtle mt-auto pt-2 text-xs font-medium">
              {pattern.source}
            </span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
