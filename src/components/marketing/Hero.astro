---
/**
 * Home hero: positioning, the install command and the 1.0 vs 2.0 build race.
 * The race renders its final numbers, so it reads correctly without JavaScript
 * or with reduced motion. The script only replays it.
 */
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import NpmCopyButton from '@/components/ui/marketing/NpmCopyButton/NpmCopyButton.astro';

const before = 13.9;
const after = 6.3;
const facts = ['MIT licensed', 'Node 22+', 'Vercel, Netlify, Cloudflare or any Node host'];
const stats = [
  { value: '2.2×', label: 'faster build' },
  { value: '1.2 KB', label: 'JS per page, was 5.7' },
  { value: '8', label: 'project shapes built in CI' },
];
---

<section class="v-hero" data-hero>
  <div class="v-hero-grid" aria-hidden="true"></div>
  <div class="v-glow" aria-hidden="true" data-hero-glow></div>
  <div class="v-watermark" aria-hidden="true">2.1</div>

  <div class="container v-hero-inner">
    <div class="flex min-w-0 flex-col items-start gap-8">
      <a
        href="/blog/velocity-2-1-ai-agents"
        class="v-rise border-border bg-card text-foreground-secondary inline-flex min-h-8 items-center gap-2.5 rounded-full border px-3 py-1 text-xs font-medium no-underline"
      >
        <span class="v-pulse bg-brand-500 h-2 w-2 rounded-full" aria-hidden="true"></span>
        <span>New in 2.1: built for AI coding agents</span>
        <Icon name="arrow-right" size="sm" />
      </a>

      <h1 class="v-display v-giant v-rise" style="--rise-delay: 80ms;">
        <span class="text-foreground-muted block">Astro 7,</span>
        <span class="block">built for</span>
        <span class="v-highlight">production.</span>
      </h1>

      <p class="v-lead v-rise max-w-[46ch]" style="--rise-delay: 160ms;">
        The open-source Astro starter kit with 58 components, strict CSP, built-in i18n, forms that submit, and agent
        skills in every project.
      </p>

      <div class="v-rise flex w-full flex-wrap items-center gap-3" style="--rise-delay: 240ms;">
        <NpmCopyButton class="h-14 max-w-full rounded-lg font-mono text-sm sm:text-base" />
        <Button variant="secondary" size="lg" href="https://demo.deployvelocity.com" class="h-14 rounded-lg">
          See the demo
        </Button>
      </div>

      <ul
        class="v-rise text-foreground-subtle flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium"
        style="--rise-delay: 320ms;"
      >
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>

    <div class="v-surface v-rise flex min-w-0 flex-col gap-7 p-6 sm:p-8" style="--rise-delay: 240ms;">
      <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-1.5">
          <p class="v-eyebrow">Production build</p>
          <p class="text-foreground-secondary text-sm leading-normal">
            Same site, same machine, Node 24. Median of three clean builds.
          </p>
        </div>
        <Button
          variant="secondary"
          size="sm"
          class="h-11 shrink-0 px-3"
          aria-label="Replay the build comparison"
          data-race-replay
        >
          Replay
        </Button>
      </div>

      <div class="flex flex-col gap-2.5">
        <div class="text-foreground-muted flex items-baseline justify-between gap-3 text-sm font-medium">
          <span>Velocity 1.0 · Astro 6</span>
          <span class="text-foreground-secondary font-mono text-xl" data-race-time={before}>{before.toFixed(1)} s</span>
        </div>
        <div class="v-race-track">
          <div class="v-race-fill bg-foreground-subtle" style="width: 100%;" data-race-bar={before}></div>
        </div>
      </div>

      <div class="flex flex-col gap-2.5">
        <div class="text-foreground flex items-baseline justify-between gap-3 text-sm font-semibold">
          <span>Velocity 2.0 · Astro 7</span>
          <span class="font-mono text-xl" data-race-time={after}>{after.toFixed(1)} s</span>
        </div>
        <div class="v-race-track">
          <div
            class="v-race-fill bg-brand-500"
            style={`width: ${((after / before) * 100).toFixed(1)}%;`}
            data-race-bar={after}
          >
          </div>
        </div>
      </div>

      <dl class="border-border grid grid-cols-3 gap-4 border-t pt-5">
        {
          stats.map((stat) => (
            <div class="flex flex-col-reverse justify-end gap-1">
              <dt class="text-foreground-subtle text-xs font-medium">{stat.label}</dt>
              <dd class="v-display text-[1.75rem] leading-none">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero) {
    const glow = hero.querySelector<HTMLElement>('[data-hero-glow]');
    const times = [...hero.querySelectorAll<HTMLElement>('[data-race-time]')];
    const bars = [...hero.querySelectorAll<HTMLElement>('[data-race-bar]')];
    const longest = Math.max(...times.map((el) => Number(el.dataset.raceTime)));
    const secondsPerMs = 1 / 200;
    let frame = 0;

    const paint = (elapsed: number) => {
      times.forEach((el) => {
        el.textContent = `${Math.min(Number(el.dataset.raceTime), elapsed).toFixed(1)} s`;
      });
      bars.forEach((el) => {
        el.style.width = `${(Math.min(Number(el.dataset.raceBar), elapsed) / longest) * 100}%`;
      });
    };

    const race = () => {
      cancelAnimationFrame(frame);
      if (reduced.matches) return paint(longest);
      const start = performance.now();
      const tick = (now: number) => {
        const elapsed = (now - start) * secondsPerMs;
        paint(elapsed);
        if (elapsed < longest) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };

    hero.querySelector('[data-race-replay]')?.addEventListener('click', race);
    race();

    if (glow && window.matchMedia('(hover: hover)').matches) {
      hero.addEventListener('pointermove', (event) => {
        if (reduced.matches) return;
        const rect = hero.getBoundingClientRect();
        glow.style.setProperty('--glow-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
        glow.style.setProperty('--glow-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
      });
    }
  }
</script>
