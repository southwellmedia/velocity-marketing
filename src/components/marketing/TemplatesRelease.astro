---
/**
 * Premium templates teaser beside the latest release. Templates have no signup
 * backend yet, so the call to action links out instead of collecting emails.
 */
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

const templates = [
  ['Medical Practice', 'Healthcare and wellness'],
  ['Agency Portfolio', 'Creative and studio'],
  ['Developer Blog', 'Content and MDX'],
  ['E-Commerce', 'Storefront and catalog'],
];

const releaseNotes = [
  'AGENTS.md and project rules in every new project.',
  'Skills for adding pages and components the Velocity way.',
  'Agents know which files upgrades replace.',
];
---

<section id="templates" class="v-section pt-0!">
  <div class="container v-split">
    <div class="v-surface flex flex-col gap-6 p-6 sm:p-10">
      <div class="flex items-center justify-between gap-4">
        <p class="v-eyebrow">Premium templates</p>
        <Badge variant="brand">Coming soon</Badge>
      </div>
      <h2 class="v-display v-h3">Start from a finished site.</h2>
      <table class="v-table">
        <caption class="sr-only">Planned premium templates</caption>
        <tbody>
          {
            templates.map(([name, category]) => (
              <tr>
                <td class="text-foreground font-semibold">{name}</td>
                <td class="text-foreground-muted text-right">{category}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-2">
        <div class="flex max-w-[30ch] flex-col gap-1">
          <span class="v-display text-[2.5rem] leading-none">$199</span>
          <span class="text-foreground-subtle text-xs font-medium">
            One-time. Every current and future template, full source, commercial license.
          </span>
        </div>
        <Button size="lg" href="https://github.com/southwellmedia/velocity" target="_blank">Follow on GitHub</Button>
      </div>
    </div>

    <a class="v-surface v-release gap-6 p-6 sm:p-10" href="/blog/velocity-2-1-ai-agents">
      <span class="flex items-center justify-between gap-4">
        <span class="v-eyebrow">Latest release</span>
        <time datetime="2026-11-04" class="text-foreground-subtle text-xs font-medium">November 4, 2026</time>
      </span>
      <span class="v-display v-h3">Velocity 2.1: Built for AI Coding Agents</span>
      <span class="text-foreground-muted leading-relaxed">
        Every project now ships with agent rules and skills, so Claude Code, Codex and Cursor can add pages and components
        the Velocity way.
      </span>
      <span class="text-foreground-secondary flex flex-col gap-2.5 text-sm leading-normal">
        {
          releaseNotes.map((note) => (
            <span class="flex items-start gap-2.5">
              <span class="text-foreground-subtle w-7 shrink-0 font-mono text-xs leading-5">2.1</span>
              {note}
            </span>
          ))
        }
      </span>
      <span class="v-link mt-auto">Read the release notes <Icon name="arrow-right" size="sm" /></span>
    </a>
  </div>
</section>
