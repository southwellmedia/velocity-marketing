---
/**
 * Premium offer pinned beside the templates, with the latest release below.
 * Checkout runs on Polar, which also invites buyers to the private templates
 * repository.
 *
 * To add a template, move it from `plannedTemplates` to `liveTemplates`. Live
 * and planned templates share one scrolling row beside the offer: cards snap
 * into place, the edge fades while there is more to see, and arrow buttons
 * step through them. Planned templates show as sketched cards at the end.
 */
import { Image } from 'astro:assets';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import medicalPractice from '@/assets/templates/medical-practice.png';
import ecommerceStore from '@/assets/templates/ecommerce-store.png';
import realEstate from '@/assets/templates/real-estate.png';

const checkoutUrl = 'https://buy.polar.sh/polar_cl_nAA9sZJmlwO6K0MfkPojRrWnKblhcnyqiidG2217nf9';

const benefits = [
  'Every current and future template',
  'Full source, with a commercial license',
  'Unlimited sites, including client work',
  'English and Spanish, light and dark',
];

const liveTemplates = [
  {
    name: 'Medical Practice',
    category: 'Healthcare and wellness',
    url: 'https://medical.deployvelocity.com',
    image: medicalPractice,
    alt: 'Home page of the Medical Practice template, for a fictional clinic called Velocity Health',
  },
  {
    name: 'E-commerce Store',
    category: 'Retail and outdoor',
    url: 'https://store.deployvelocity.com',
    image: ecommerceStore,
    alt: 'Home page of the E-commerce Store template, for a fictional outdoor brand called Northline',
  },
  {
    name: 'Real Estate',
    category: 'Property and rentals',
    url: 'https://realestate.deployvelocity.com',
    image: realEstate,
    alt: 'Home page of the Real Estate template, for a fictional brokerage called Oakhaven Realty',
  },
];

const plannedTemplates = [
  { name: 'Agency Portfolio', category: 'Studios and freelancers', sketch: 'portfolio' },
  { name: 'Developer Blog', category: 'Writing and documentation', sketch: 'blog' },
] as const;
---

<section id="templates" class="v-section pt-0!">
  <div class="container flex flex-col gap-6">
    <div class="v-premium">
      <div class="v-surface flex flex-col gap-6 p-6 sm:p-8">
        <p class="v-eyebrow">Premium templates</p>
        <h2 class="v-display v-h3">Start from a finished site.</h2>
        <div class="flex flex-col gap-1">
          <span class="v-display text-[2.5rem] leading-none">$199</span>
          <span class="text-foreground-subtle text-xs font-medium">One-time. All sales final.</span>
        </div>
        <ul class="text-foreground-secondary flex flex-col gap-2.5 text-sm leading-normal">
          {benefits.map((benefit) => (
            <li class="flex items-start gap-2.5">
              <Icon name="check" size="sm" class="text-foreground-subtle mt-0.5 shrink-0" />
              {benefit}
            </li>
          ))}
        </ul>
        <div class="flex flex-col gap-3">
          <Button size="lg" href={checkoutUrl} fullWidth>
            Get lifetime access
          </Button>
          <span class="text-foreground-subtle text-xs font-medium">
            Requires a free GitHub account.
          </span>
        </div>
      </div>

      <div class="flex min-w-0 flex-col gap-5">
        <div class="flex items-center justify-between gap-4">
          <p class="v-count">
            <span class="v-count-live">
              <span class="v-count-dot" aria-hidden="true"></span>
              {liveTemplates.length} live
            </span>
            <span class="v-count-divider" aria-hidden="true"></span>
            <span>{plannedTemplates.length} in the works</span>
          </p>
          <div class="flex shrink-0 gap-2" data-carousel-controls>
            <button
              type="button"
              class="v-carousel-arrow"
              data-carousel-prev
              aria-label="Previous templates"
              disabled
            >
              <Icon name="arrow-left" size="sm" />
            </button>
            <button
              type="button"
              class="v-carousel-arrow"
              data-carousel-next
              aria-label="Next templates"
            >
              <Icon name="arrow-right" size="sm" />
            </button>
          </div>
        </div>
        <div class="v-carousel" data-carousel data-at-start>
          <ul class="v-carousel-track" data-carousel-track aria-label="Templates">
            {liveTemplates.map((template) => (
              <li class="v-carousel-item">
                <a
                  class="v-surface v-release h-full overflow-hidden"
                  href={template.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Image
                    src={template.image}
                    alt={template.alt}
                    widths={[480, 720, 960, 1280]}
                    sizes="(min-width: 1024px) 40vw, 85vw"
                    class="v-carousel-media w-full object-cover object-left-top"
                  />
                  <span class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 p-4 sm:px-5">
                    <span class="flex flex-col">
                      <span class="text-foreground font-semibold">{template.name}</span>
                      <span class="text-foreground-muted text-sm">{template.category}</span>
                    </span>
                    <span class="v-link">
                      View live demo <Icon name="arrow-right" size="sm" />
                    </span>
                  </span>
                </a>
              </li>
            ))}
            {plannedTemplates.map((template) => (
              <li class="v-carousel-item">
                <div
                  class="v-surface v-planned flex h-full flex-col overflow-hidden"
                  aria-label={`${template.name}, planned`}
                >
                  <div
                    class="v-sketch v-carousel-media relative overflow-hidden"
                    aria-hidden="true"
                  >
                    <div class="v-sketch-bar">
                      <span class="v-sketch-dot" />
                      <span class="v-sketch-line w-12" />
                      <span class="ml-auto flex gap-1.5">
                        <span class="v-sketch-line w-6" />
                        <span class="v-sketch-line w-6" />
                        <span class="v-sketch-line w-6" />
                      </span>
                    </div>
                    {template.sketch === 'portfolio' ? (
                      <div class="flex flex-col gap-3 px-5 pt-4">
                        <span class="v-sketch-line h-3 w-3/5" />
                        <span class="v-sketch-line h-3 w-2/5" />
                        <span class="v-sketch-line mt-1 w-1/3" />
                        <div class="mt-3 grid grid-cols-3 gap-2">
                          <span class="v-sketch-block aspect-[4/3]" />
                          <span class="v-sketch-block aspect-[4/3]" />
                          <span class="v-sketch-block aspect-[4/3]" />
                        </div>
                      </div>
                    ) : (
                      <div class="flex flex-col gap-3 px-5 pt-4">
                        <span class="v-sketch-line h-3 w-1/2" />
                        <span class="v-sketch-line w-2/3" />
                        <div class="mt-2 flex flex-col gap-2">
                          <span class="v-sketch-row">
                            <span class="v-sketch-block size-8 shrink-0" />
                            <span class="flex flex-1 flex-col gap-1.5">
                              <span class="v-sketch-line w-3/4" />
                              <span class="v-sketch-line w-1/2 opacity-60" />
                            </span>
                          </span>
                          <span class="v-sketch-row">
                            <span class="v-sketch-block size-8 shrink-0" />
                            <span class="flex flex-1 flex-col gap-1.5">
                              <span class="v-sketch-line w-2/3" />
                              <span class="v-sketch-line w-2/5 opacity-60" />
                            </span>
                          </span>
                        </div>
                      </div>
                    )}
                    <span class="v-sketch-badge">Planned</span>
                  </div>
                  <span class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 p-4 sm:px-5">
                    <span class="flex flex-col">
                      <span class="text-foreground font-semibold">{template.name}</span>
                      <span class="text-foreground-muted text-sm">{template.category}</span>
                    </span>
                    <span class="text-foreground-subtle text-sm font-medium">In the works</span>
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <a
      class="v-surface v-release flex-row! flex-wrap items-center justify-between gap-x-6 gap-y-3 p-5 sm:px-6"
      href="/blog/velocity-2-1-ai-agents"
    >
      <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span class="v-eyebrow">Latest release</span>
        <span class="text-foreground font-semibold">Velocity 2.1: Built for AI Coding Agents</span>
      </span>
      <span class="v-link">
        Read the release notes <Icon name="arrow-right" size="sm" />
      </span>
    </a>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const section = carousel.closest('section');
    const prev = section?.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = section?.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prev || !next) return;

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const atStart = track.scrollLeft <= 1;
      const atEnd = track.scrollLeft >= max - 1;
      carousel.toggleAttribute('data-at-start', atStart);
      carousel.toggleAttribute('data-at-end', atEnd);
      prev.disabled = atStart;
      next.disabled = atEnd;
    };

    const step = (direction: number) => {
      const item = track.querySelector<HTMLElement>('.v-carousel-item');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const distance = (item?.offsetWidth ?? track.clientWidth) + gap;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollBy({ left: direction * distance, behavior: reduced ? 'auto' : 'smooth' });
    };

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
