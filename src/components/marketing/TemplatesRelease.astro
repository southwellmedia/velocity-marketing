---
/**
 * Premium templates beside the latest release. Checkout runs on Polar, which also
 * invites buyers to the private templates repository.
 */
import { Image } from 'astro:assets';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import medicalPractice from '@/assets/templates/medical-practice.png';

const medicalDemoUrl = 'https://medical.deployvelocity.com';
const checkoutUrl = 'https://buy.polar.sh/polar_cl_nAA9sZJmlwO6K0MfkPojRrWnKblhcnyqiidG2217nf9';

const templates = [
  ['Agency Portfolio', 'Creative and studio'],
  ['Developer Blog', 'Content and MDX'],
  ['E-Commerce', 'Storefront and catalog'],
];

const releaseNotes = [
  'AGENTS.md and project rules in every new project.',
  'Skills for adding pages and components the Velocity way.',
  'Agents know which files upgrades replace.',
];
---

<section id="templates" class="v-section pt-0!">
  <div class="container v-split">
    <div class="v-surface flex flex-col gap-6 p-6 sm:p-10">
      <p class="v-eyebrow">Premium templates</p>
      <h2 class="v-display v-h3">Start from a finished site.</h2>
      <a
        class="border-border-subtle group flex flex-col overflow-hidden rounded-lg border"
        href={medicalDemoUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Image
          src={medicalPractice}
          alt="Home page of the Medical Practice template, for a fictional clinic called Velocity Health"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="aspect-[16/10] w-full object-cover object-top"
        />
        <span class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 p-4">
          <span class="flex flex-col">
            <span class="text-foreground font-semibold">Medical Practice</span>
            <span class="text-foreground-muted text-sm">Healthcare and wellness</span>
          </span>
          <span class="v-link">View live demo <Icon name="arrow-right" size="sm" /></span>
        </span>
      </a>
      <p class="text-foreground-subtle -mt-3 text-xs font-medium">Demo photos not included.</p>
      <table class="v-table">
        <caption class="text-foreground-subtle pb-2 text-left text-xs font-medium">Planned templates</caption>
        <tbody>
          {
            templates.map(([name, category]) => (
              <tr>
                <td class="text-foreground font-semibold">{name}</td>
                <td class="text-foreground-muted text-right">{category}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="mt-auto flex flex-wrap items-end justify-between gap-4 pt-2">
        <div class="flex max-w-[30ch] flex-col gap-1">
          <span class="v-display text-[2.5rem] leading-none">$199</span>
          <span class="text-foreground-subtle text-xs font-medium">
            One-time. Every current and future template, full source, commercial license. 14-day refunds. Requires a free
            GitHub account.
          </span>
        </div>
        <Button size="lg" href={checkoutUrl}>Get lifetime access</Button>
      </div>
    </div>

    <a class="v-surface v-release gap-6 p-6 sm:p-10" href="/blog/velocity-2-1-ai-agents">
      <span class="flex items-center justify-between gap-4">
        <span class="v-eyebrow">Latest release</span>
        <time datetime="2026-11-04" class="text-foreground-subtle text-xs font-medium">November 4, 2026</time>
      </span>
      <span class="v-display v-h3">Velocity 2.1: Built for AI Coding Agents</span>
      <span class="text-foreground-muted leading-relaxed">
        Every project now ships with agent rules and skills, so Claude Code, Codex and Cursor can add pages and components
        the Velocity way.
      </span>
      <span class="text-foreground-secondary flex flex-col gap-2.5 text-sm leading-normal">
        {
          releaseNotes.map((note) => (
            <span class="flex items-start gap-2.5">
              <span class="text-foreground-subtle w-7 shrink-0 font-mono text-xs leading-5">2.1</span>
              {note}
            </span>
          ))
        }
      </span>
      <span class="v-link mt-auto">Read the release notes <Icon name="arrow-right" size="sm" /></span>
    </a>
  </div>
</section>
