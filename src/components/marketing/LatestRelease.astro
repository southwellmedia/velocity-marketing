---
/**
 * One-line link to the latest release notes, under the Premium teaser.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
---

<section class="py-[clamp(2.5rem,6vw,4rem)]">
  <div class="container">
    <a
      class="v-surface v-release flex-row! flex-wrap items-center justify-between gap-x-6 gap-y-3 p-5 sm:px-6"
      href="/blog/velocity-2-1-ai-agents"
    >
      <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span class="v-eyebrow">Latest release</span>
        <span class="text-foreground font-semibold">Velocity 2.1: Built for AI Coding Agents</span>
      </span>
      <span class="v-link">
        Read the release notes <Icon name="arrow-right" size="sm" />
      </span>
    </a>
  </div>
</section>
