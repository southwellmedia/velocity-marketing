---
/**
 * AI coding agents section. Static, so it adds no JavaScript to the page.
 */
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';

const points = [
  {
    title: 'Project rules',
    text: 'AGENTS.md and .agents/velocity.md give agents your stack, commands and conventions from the first prompt.',
  },
  {
    title: 'Task skills',
    text: 'Step-by-step skills for adding pages and components, ready for Claude Code and other tools.',
  },
  {
    title: 'Upgrade-safe',
    text: 'Agents know which files upgrades replace, so your work stays where it belongs.',
  },
];

const steps = [
  ['src/views/PricingView.astro', 'page content'],
  ['src/pages/pricing.astro', 'default locale'],
  ['src/pages/[lang]/[...pricing].astro', 'localized URLs'],
  ['src/config/nav.config.ts', 'route and menu'],
  ['src/i18n/translations/en.ts', 'page copy'],
];
---

<section
  id="ai-agents"
  aria-labelledby="ai-agents-heading"
  style="padding-top: var(--space-section); padding-bottom: var(--space-section);"
>
  <div class="container grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <Badge variant="brand">New in Velocity 2.1</Badge>
      <h2
        id="ai-agents-heading"
        class="font-display text-foreground mt-4 font-bold tracking-tight"
        style="font-size: var(--text-4xl);"
      >
        Your AI agent already knows the rules.
      </h2>
      <p class="text-foreground-muted mt-4 text-lg">
        Every Velocity project ships with instructions for Claude Code, Codex, Cursor and other coding agents, so they
        build the Velocity way without being told.
      </p>

      <ul class="mt-8 space-y-5">
        {
          points.map((point) => (
            <li>
              <h3 class="font-display text-foreground text-lg font-semibold">{point.title}</h3>
              <p class="text-foreground-muted mt-1 text-sm">{point.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/blog/velocity-2-1-ai-agents">Read the announcement</Button>
        <Button variant="outline" href="https://docs.deployvelocity.com/getting-started/ai-agents/" target="_blank">
          Agent guide
        </Button>
      </div>
    </div>

    <div class="border-border bg-background-secondary min-w-0 rounded-xl border p-5 font-mono text-sm">
      <p class="text-foreground">
        <span class="text-brand-500" aria-hidden="true">&gt;</span> Add a Pricing page and put it in the nav.
      </p>
      <p class="text-foreground-muted mt-4">Using velocity-add-page</p>
      <ul class="mt-3 space-y-2">
        {
          steps.map(([file, purpose]) => (
            <li class="flex flex-wrap justify-between gap-x-4">
              <span class="text-foreground min-w-0 break-all">{file}</span>
              <span class="text-foreground-muted">{purpose}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
