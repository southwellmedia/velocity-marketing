---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@/components/marketing/Hero.astro';
import StatementTicker from '@/components/marketing/StatementTicker.astro';
import FeatureBento from '@/components/marketing/FeatureBento.astro';
import HowItShips from '@/components/marketing/HowItShips.astro';
import ComponentMarquee from '@/components/marketing/ComponentMarquee.astro';
import ShowcaseGallery from '@/components/marketing/ShowcaseGallery.astro';
import PremiumTeaser from '@/components/marketing/PremiumTeaser.astro';
import LatestRelease from '@/components/marketing/LatestRelease.astro';
import GetStarted from '@/components/marketing/GetStarted.astro';
---

<MarketingLayout
  title="Astro 7 Starter Kit & Boilerplate"
  description="The production-ready Astro 7 starter kit and boilerplate. 58 components, a full design token system, built-in i18n, AI agent skills, and 100 Lighthouse scores for accessibility and SEO. Free and open source."
  image="/velocity-og.jpg"
  imageAlt="Velocity: Astro 7, built for production. 58 components, strict CSP, built-in i18n and agent skills."
>
  <Hero />
  <StatementTicker />
  <FeatureBento />
  <HowItShips />
  <ComponentMarquee />
  <ShowcaseGallery />
  <PremiumTeaser />
  <LatestRelease />
  <GetStarted />
</MarketingLayout>
