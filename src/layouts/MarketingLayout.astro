---
/**
 * MarketingLayout
 * Layout wrapper for marketing pages with floating capsule header
 * Uses Header shape="floating" for a distinctive visual identity
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import MarketingFooter from '@/components/marketing/MarketingFooter.astro';
import Logo from '@/components/ui/marketing/Logo/Logo.astro';
import '@/styles/marketing.css';
import '@/styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
} = Astro.props;

const nav = [
  { label: 'Features', href: '/#features' },
  { label: 'Components', href: '/components' },
  { label: 'Showcase', href: '/#showcase' },
  { label: 'Premium', href: '/premium' },
  { label: 'Blog', href: '/blog' },
  { label: 'Docs', href: 'https://docs.deployvelocity.com' },
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
>
  <Header
    slot="header"
    shape="floating"
    variant="transparent"
    position="fixed"
    colorScheme="default"
    nav={nav}
    showCta={true}
    class="[&_a]:whitespace-nowrap"
    cta={{ label: 'View Demo', href: 'https://demo.deployvelocity.com' }}
    actions={[{ icon: 'github', href: 'https://github.com/southwellmedia/velocity', label: 'GitHub', iconOnly: true, target: '_blank' }]}
    showLanguageSwitcher={false}
  >
    <a slot="logo" href="/" class="flex items-center gap-2">
      <Logo size="sm" />
      <span class="font-display hdr-logo-text text-xl font-bold tracking-tight">Velocity</span>
      <span class="hdr-invert-text hidden rounded-md border border-current/25 px-1.5 py-0.5 text-[10px] leading-none font-medium sm:inline">
        v2.1
      </span>
    </a>
  </Header>

  <slot />

  <MarketingFooter slot="footer" />
</BaseLayout>
